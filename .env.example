# ── 데이터베이스 (STEP 1) ────────────────────────────────────
# 비우면 인메모리 폴백으로 동작한다(개발 전용, 재시작 시 소멸).
DATABASE_URL=

# ── 인증 (STEP 2) ───────────────────────────────────────────
# 32자 이상. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── AI 검열/번역 (STEP 3) ───────────────────────────────────
# 키가 비어 있으면 룰베이스 검열만 동작한다. 키를 넣고 MODERATION_AI=on 으로 바꾸면 켜진다.
ANTHROPIC_API_KEY=
MODERATION_AI=off
MODERATION_MODEL=claude-sonnet-4-6

# ── 레이트리밋 (STEP 2/4) ───────────────────────────────────
# 비우면 인메모리 폴백(서버리스에서는 인스턴스 간 공유 안 됨 — 배포 전 반드시 설정).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 배포 (STEP 4) ───────────────────────────────────────────
# Vercel Cron 이 /api/cron/cleanup 을 호출할 때 쓰는 공유 비밀. 비우면 검증하지 않는다.
CRON_SECRET=

# ── 관리자 ──────────────────────────────────────────────────
ADMIN_NAME=admin
ADMIN_PW_HASH=

# ── 학교 인증 메일 (학생 뱃지) ───────────────────────────────
# 비우면 실제 발송 없이 서버 로그에 코드만 남는다(개발용). Resend 무료 3천통/월.
RESEND_API_KEY=
MAIL_FROM=

# ── 소셜 로그인 ─────────────────────────────────────────────
# 짝(ID+SECRET)이 채워진 제공자만 로그인 화면에 나타난다. 전부 비어 있으면
# 기존 닉네임+비밀번호 로그인만 노출된다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
