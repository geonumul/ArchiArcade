// ARCHI ARCADE — STEP 1 (핵심 도메인) + STEP 1.5 (수익화) 통합 스키마
// 설계 근거는 docs/PHASE2.md 의 "저장 키 → 테이블 매핑" 및 docs/DEV_HANDOFF.md 참고.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// STEP 1 — 핵심 도메인
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  pwHash    String
  /// 비밀번호 찾기의 유일한 통로. 이것이 없으면 계정을 되돌릴 방법이 없다.
  /// 기존 계정에는 값이 없을 수 있어 옵셔널이지만, 새 가입에서는 반드시 받는다.
  email           String?   @unique
  /// 메일로 소유를 확인한 시각. 학교 메일이면 이 시점에 학생 뱃지도 함께 발급된다.
  emailVerifiedAt DateTime?
  locale    String   @default("ko")
  createdAt DateTime @default(now())

  profile      Profile?
  memberships  OrgMember[]
  applications JobApplication[]
  hostedRooms  Room[]
  reports      Report[]
  reactions    ReactionVote[]
  answers      AnswerLog[]
  marketing    MarketingConsent?
  archqScores  ArchqScore[]
}

/// 비밀번호 재설정 코드. 원문 대신 해시만 두고 만료·시도 횟수로 무차별 대입을 막는다
/// — VerifyCode 와 같은 방식이지만 용도가 달라 섞지 않는다.
model PasswordReset {
  email     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model Profile {
  userId     String @id
  plays      Int    @default(0)
  minorPicks Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 문항 원본. 9개 언어가 같은 idx 를 공유하는 것이 전역 투표 합산의 기반이다.
/// idx 정렬이 깨지면 통계 전체가 무의미해지므로 (idx, lang) 유니크로 강제한다.
model Question {
  id             Int     @id @default(autoincrement())
  idx            Int
  lang           String
  q              String
  a              String
  b              String
  /// 국가별 현지화 문항(거장·답사지·야식 등). 글로벌 비교 리포트에서 분리 집계한다.
  isLocalVariant Boolean @default(false)

  @@unique([idx, lang])
  @@index([lang])
}

model Vote {
  id          BigInt   @id @default(autoincrement())
  questionIdx Int
  choice      String // "a" | "b"
  lang        String
  roomCode    String?
  createdAt   DateTime @default(now())

  /// 인증된 학생의 표에만 채워진다. 학교별 순위와, 데이터 상품에서
  /// "검증된 건축학도 응답"만 따로 집계하기 위한 근거가 된다.
  schoolDomain String?
  major        String?

  @@index([questionIdx])
  @@index([createdAt])
  @@index([lang, questionIdx])
  @@index([schoolDomain])
}

model Room {
  code      String   @id
  pwHash    String
  hostId    String?
  state     Json
  createdAt DateTime @default(now())
  /// 상태가 마지막으로 바뀐 시각. 버려진 방이 정원을 계속 차지하지 않도록
  /// 동시접속 집계에서 최근 활동한 방만 세는 데 쓴다.
  updatedAt DateTime @updatedAt
  /// 입장한 인원과 호스트가 정한 정원. 정원이 차면 새 입장을 막는다.
  playerCount Int    @default(0)
  maxPlayers  Int    @default(30)
  expiresAt DateTime

  // STEP 1.5 — 조직 방 여부. 둘 다 null 이면 개인 방(무료).
  orgId         String?
  sponsorId     String?
  questionSetId String?

  host        User?        @relation(fields: [hostId], references: [id], onDelete: SetNull)
  org         Org?         @relation(fields: [orgId], references: [id], onDelete: SetNull)
  sponsor     Sponsor?     @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  questionSet QuestionSet? @relation(fields: [questionSetId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([orgId, createdAt])
  @@index([updatedAt])
}

model Post {
  id        Int      @id @default(autoincrement())
  board     String // "ideas" | "qfeedback" | "school"
  author    String
  body      String
  type      String?
  lang      String
  createdAt DateTime @default(now())

  /// 학교 커뮤니티 글일 때만 채워진다. 인증된 같은 학교 학생에게만 보인다.
  schoolDomain String?
  /// 건축학 · 건축공학 · 실내건축 · 도시공학 · 조경 · 공간디자인 (lib/school.ts MAJORS)
  major        String?

  translations TranslationCache[]

  @@index([board, createdAt])
  @@index([schoolDomain, createdAt])
}

/// 학교 메일로 인증한 학생. 계정(User)과 무관하게 존재할 수 있다 —
/// 가입 없이 인증만으로 뱃지·학교 커뮤니티·동문 디렉터리를 쓰게 하기 위해서다.
model StudentVerification {
  id         String   @id @default(cuid())
  email      String   @unique
  /// 집계 키. 서브도메인을 정규화한 대표 도메인이 들어간다.
  schoolDomain String
  /// 영문 이름. 화면에서 크게 쓴다.
  schoolName   String
  /// 현지어 이름. 영문 옆에 작게 붙인다. 출처가 없는 학교는 비어 있다.
  schoolLocal  String?
  country      String
  major        String
  verifiedAt   DateTime @default(now())

  /// 동문 디렉터리 공개 동의. 기본은 비공개이며 본인이 켤 때만 목록에 나타난다.
  directoryOptIn Boolean @default(false)
  /// 디렉터리에 노출할 정보. 동의했을 때만 의미가 있다.
  displayName    String?
  /// "student"(재학) | "alumni"(졸업). 학교 인증은 재학생이 먼저 하므로 재학이 기본이다.
  /// 졸업연도로 유추하지 않고 따로 두는 이유는, 재학생도 졸업 예정연도를 적을 수 있고
  /// 그 둘을 같은 값으로 섞으면 목록에서 재학생이 졸업생으로 보이기 때문이다.
  status         String  @default("student")
  /// 졸업했으면 졸업연도, 재학 중이면 졸업 예정연도. 비워 둘 수 있다.
  gradYear       Int?
  company        String?

  @@index([schoolDomain, major])
  @@index([schoolDomain, directoryOptIn])
}

/// 인증 코드. 원문 대신 해시만 저장하고 만료·시도 횟수로 무차별 대입을 막는다.
model VerifyCode {
  email     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model QuestionReact {
  questionIdx Int @id
  hot         Int @default(0)
  meh         Int @default(0)

  /// 노잼이 기준만큼 쌓인 시각. 어느 문항이 재미없는지는 사람들이 이미 알고
  /// 있는데 그걸 모아 볼 자리가 없었다. 관리자가 손보고 나면 resolvedAt 이 찍혀
  /// 목록에서 내려간다 — 같은 문항이 매번 다시 올라오면 목록을 보지 않게 된다.
  flaggedAt  DateTime?
  resolvedAt DateTime?

  @@index([flaggedAt])
}

/// 커뮤니티 카드 ♥ 관심도 — 어느 시장에 어떤 기능부터 낼지 판단하는 근거 데이터.
model FeatureInterest {
  feature String
  lang    String
  count   Int    @default(0)

  @@id([feature, lang])
}

// ─────────────────────────────────────────────────────────────
// STEP 3 — AI 프록시 부속 테이블
// ─────────────────────────────────────────────────────────────

model TranslationCache {
  postId    Int
  lang      String
  body      String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, lang])
}

/// 검열 감사 로그. 원문 전체가 아니라 해시와 판정만 남긴다.
model ModerationLog {
  id        BigInt   @id @default(autoincrement())
  bodyHash  String
  lang      String
  engine    String // "rules" | "ai"
  ok        Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// STEP 1.5 — 수익화 (개인 학생은 무료·무광고, 과금은 Org 단위)
// ─────────────────────────────────────────────────────────────

model Org {
  id           String   @id @default(cuid())
  name         String
  kind         String // "university" | "firm" | "society"
  seats        Int      @default(0)
  billingEmail String
  createdAt    DateTime @default(now())

  members      OrgMember[]
  licenses     License[]
  usage        SessionUsage[]
  questionSets QuestionSet[]
  jobPosts     JobPost[]
  rooms        Room[]
}

model OrgMember {
  orgId    String
  userId   String
  role     String   @default("member") // "owner" | "admin" | "member"
  joinedAt DateTime @default(now())

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
}

model License {
  id          String   @id @default(cuid())
  orgId       String
  plan        String // "session" | "seat" | "annual"
  seatsMax    Int
  sessionsMax Int?
  startsAt    DateTime
  endsAt      DateTime
  status      String   @default("active") // "active" | "expired" | "suspended"

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
}

/// 세션 라이선스 과금의 근거. 방이 열릴 때마다 한 줄씩 쌓인다.
model SessionUsage {
  id        BigInt    @id @default(autoincrement())
  orgId     String
  roomCode  String
  players   Int
  startedAt DateTime
  endedAt   DateTime?
  billable  Boolean   @default(true)

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
}

/// 조직 커스텀 문항셋. 기본 154문항 위에 얹는 형태.
model QuestionSet {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  logoUrl   String?
  items     Json
  createdAt DateTime @default(now())

  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rooms Room[]

  @@index([orgId])
}

model Sponsor {
  id            String   @id @default(cuid())
  name          String
  cartridgeSlug String   @unique
  logoUrl       String?
  cpmCents      Int
  activeFrom    DateTime
  activeTo      DateTime
  status        String   @default("draft") // "draft" | "live" | "ended"

  impressions SponsorImpression[]
  rooms       Room[]
}

model SponsorImpression {
  id        BigInt   @id @default(autoincrement())
  sponsorId String
  lang      String
  roomCode  String?
  shownAt   DateTime @default(now())

  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId, shownAt])
}

model JobPost {
  id        String   @id @default(cuid())
  orgId     String
  title     String
  body      String
  lang      String
  feeCents  Int
  status    String   @default("open") // "open" | "filled" | "closed"
  createdAt DateTime @default(now())

  org          Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([orgId, status])
}

model JobApplication {
  id        String    @id @default(cuid())
  jobPostId String
  userId    String
  status    String    @default("sent") // "sent" | "interview" | "placed" | "rejected"
  /// 성사 시각 = 수수료 청구 트리거
  placedAt  DateTime?
  createdAt DateTime  @default(now())

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, userId])
}

/// 연간 "국가별 건축학도 인식 비교" 리포트 산출물.
model ReportExport {
  id          String   @id @default(cuid())
  year        Int
  scope       String // "global" | "lang" | "org"
  scopeKey    String?
  fileUrl     String
  generatedAt DateTime @default(now())

  @@index([year, scope])
}

// ─────────────────────────────────────────────────────────────
// 원본 index.html 이 쓰는 공용 키-값 저장소
// ─────────────────────────────────────────────────────────────

/// 원본 SPA 는 `window.storage` 하나로 방 상태·투표·게시글·회원을 전부 다룬다.
/// 화면을 원본 그대로 두기 위해 그 인터페이스를 여기에 그대로 받아 준다.
/// 도메인 테이블(Room, Vote, Post …)은 정규화된 집계용이고, 이쪽은 원본 호환용이다.
model Kv {
  key       String    @id
  value     String
  /// 방·투표처럼 수명이 있는 키는 만료 시각을 달아 cleanup 크론이 걷어 간다.
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

/// 질문 밸런스 제보(공작소). 관리자와 본인만 볼 수 있어야 하므로 공용 저장소에서
/// 옮겨 왔다 — 그 저장소는 누구나 읽을 수 있어 화면에서 숨겨도 소용이 없었다.
model Report {
  id        String   @id @default(cuid())
  /**
   * 어느 게시판인가.
   *   "report" - 질문 밸런스 제보(공작소). 관리자와 본인만 본다.
   *   "idea"   - 다음 카트리지 신청. 모두가 본다.
   *
   * 두 게시판을 한 표에 둔 이유는 규칙이 같아서다. 넣으려면 로그인해야 하고,
   * 지우는 건 본인이나 관리자만 할 수 있다. 다른 것은 누가 볼 수 있느냐뿐이다.
   */
  board     String   @default("report")
  /**
   * 넣은 사람. 지금은 로그인해야 글을 쓸 수 있으므로 새 글에는 항상 있다.
   *
   * 비어 있을 수 있는 것은 게시판이 공용 저장소에 있던 시절의 글 때문이다. 그때는
   * 로그인 없이 아무 이름으로 쓸 수 있어서 계정이 남아 있지 않다. 없는 계정을
   * 지어내 붙이면 그 사람이 쓴 것처럼 보이므로, 없는 것은 없는 대로 둔다.
   * 이 칸이 비었다는 것은 "옛날 글" 이라는 뜻이고, 본인 삭제는 할 수 없다.
   */
  userId    String?
  /// 그때 표시한 이름. 나중에 닉네임을 바꿔도 제보에 적힌 이름은 그대로 남는다.
  authorName String
  /// "wrong" | "idea" | "fix" 등 원본 신고 종류 코드
  kind      String
  body      String
  lang      String   @default("ko")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// 유입 측정 · 대기실 채팅 · 밸런스 조절 후보
// ─────────────────────────────────────────────────────────────

/**
 * 날짜별 유입 집계.
 *
 * 개인을 특정하지 않는다. IP 도, 방문자 구분용 쿠키나 기기 식별자도 저장하지 않고
 * (날짜·채널·기기·언어) 조합의 숫자만 더한다. 어떤 행도 한 사람을 가리키지 않으므로
 * 개인정보가 아니고, 그래서 수집 동의를 받지 않아도 된다.
 *
 * 채널은 브라우저가 알려준다. 첫 화면을 열 때 주소의 utm_source 나 어디서 왔는지를
 * 보고 정한 뒤, 그 탭이 살아 있는 동안 메모리에만 들고 있다가 사건이 생길 때 같이
 * 보낸다 - 기기에 아무것도 남기지 않으려고 이렇게 한다.
 */
model VisitStat {
  day      String // YYYY-MM-DD
  channel  String // kakao | instagram | google | naver | direct | other
  device   String // mobile | desktop
  lang     String

  /// 퍼널. 방문한 사람 중 몇이 놀았고, 몇이 가입했고, 몇이 학교 인증까지 갔는가.
  visits   Int @default(0)
  plays    Int @default(0)
  signups  Int @default(0)
  verifies Int @default(0)

  @@id([day, channel, device, lang])
  @@index([day])
}

/// 문항 리액션 중복 방지. 한 사람이 한 문항에 한 번만 누를 수 있게 한다 -
/// 노잼 수가 밸런스 조절 후보를 정하는 근거가 되므로 부풀릴 수 있으면 안 된다.
model ReactionVote {
  questionIdx Int
  userId      String
  kind        String // "hot" | "meh"
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([questionIdx, userId])
  @@index([userId])
}

/**
 * 내가 무엇을 골랐는지의 개인 기록.
 *
 * Vote 에는 userId 가 없다. 일부러 없앤 것이다. 전역 집계가 사람과 이어지는 순간
 * 그 숫자는 "밤에 솔직하게 눌러도 되는 것"이 아니게 되고, 그러면 집계 자체가
 * 쓸모없어진다. 그래서 그 표는 앞으로도 익명으로 둔다.
 *
 * 그런데 가입한 사람에게는 돌려줄 것이 있어야 한다. "네가 답한 40문항 중 11번은
 * 소수파였다" 같은 이야기는 익명 표에서 만들 수 없으니, 본인 것만 따로 여기에
 * 쌓는다. 익명 집계와 개인 기록을 한 표에 합치지 않는 이유가 이것이다 - 합치는
 * 순간 둘 중 하나는 반드시 성질을 잃는다.
 *
 * 읽는 사람은 본인뿐이고, 계정을 지우면 Cascade 로 같이 사라진다.
 * 같은 문항을 다시 풀면 줄이 늘지 않고 마지막에 고른 쪽으로 덮인다 - 한 사람의
 * "지금 생각"은 하나여야 프로필 숫자가 말이 된다.
 */
model AnswerLog {
  userId      String
  questionIdx Int
  choice      String // "a" | "b"
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, questionIdx])
}

/**
 * 관리자 접속기록.
 *
 * 「개인정보의 안전성 확보조치 기준」(개인정보보호위원회 고시) 제8조는 개인정보취급자가
 * 개인정보처리시스템에 접속한 기록을 1년 이상 보관하도록 정한다. 해도 되는 일이 아니라
 * 해야 하는 일이고, 규모가 작다고 빠지는 예외도 없다. 안 지키면 시행령 제30조제1항제5호와
 * 법 제29조를 거쳐 법 제75조제2항제5호의 과태료(3천만원 이하)로 이어진다.
 *
 * 남기는 대상은 회원 정보를 들여다보는 운영자 쪽이지, 게임하러 온 사람이 아니다.
 * 2026-10-31 시행 개정문이 「접속한 자(다만, 정보주체는 제외한다)」로 못 박은 그대로다.
 * 그래서 이 표에 방문자 접속은 한 줄도 쌓이지 않는다.
 *
 * 고시 제2조제3호가 요구하는 다섯 가지가 아래 다섯 칸이며, 하나라도 비면 접속기록으로
 * 인정되지 않는다.
 *   admin     - 식별자. 누가 봤는가
 *   createdAt - 접속일시. 언제 봤는가
 *   ip        - 접속지 정보. 어디에서 접속했는가
 *   subject   - 처리한 정보주체 정보. 누구의 개인정보를 건드렸는가
 *   action    - 수행업무. 조회인지 수정인지 삭제인지
 *
 * 보관 기간은 1년이다. 정보주체가 5만 명 미만이고 고유식별정보·민감정보를 다루지 않아
 * 2년 대상이 아니다. 자동 삭제는 아직 걸지 않았으니 지우는 배치를 만들 사람은 1년보다
 * 짧게 자르지 말 것.
 */
model AdminAccessLog {
  id BigInt @id @default(autoincrement())

  /// 관리자 계정 이름. ADMIN_NAME 과 같은 닉네임으로 로그인한 사람이다(lib/auth.ts).
  admin String

  /**
   * 접속한 곳의 IP 원문.
   *
   * 이 리포는 다른 모든 곳에서 IP 를 저장하지 않는다. 도배 방지조차 ipKey() 로 해시해
   * 쓰고 원문은 흘리지 않는다(lib/ratelimit.ts). 여기만 원문인 것은 취향이 바뀌어서가
   * 아니라 고시 제2조제3호가 "접속지 정보"를 접속기록의 필수 항목으로 요구하기
   * 때문이다. 해시로 바꾸면 기록으로서 성립하지 않는다. 다른 표를 만들 때 이 칸을
   * 선례로 삼지 말 것.
   */
  ip String

  /// 처리한 정보주체 정보. 어느 학교 목록을 펼쳤는지, 몇 명 분이 나왔는지, 지운 제보가
  /// 무엇인지처럼 "누구의 정보를 건드렸나"를 나중에 되짚을 수 있는 만큼만 적는다.
  subject String

  /// 수행업무. "동문목록 조회", "제보 삭제" 같은 짧은 서술.
  action String

  /// 접속일시.
  createdAt DateTime @default(now())

  /// 월 1회 이상 점검해야 하므로(고시 제8조) 최근 것부터 훑는 조회가 기본이고,
  /// 관리자가 여럿이 되면 사람별로도 갈라 봐야 한다.
  @@index([createdAt])
  @@index([admin, createdAt])
}

/**
 * 광고성 정보 수신 동의.
 *
 * 서비스 안내 메일(비밀번호 재설정, 방 초대, 약관 변경)은 계약 이행에 관한 정보라
 * 정보통신망법 제50조 밖이고 동의가 필요 없다. 하지만 "새 게임 열렸어요" 는 광고성
 * 정보라 명시적 사전 동의 없이는 한 통도 못 보낸다. 지금 받아 두지 않으면 나중에
 * 되돌릴 방법이 없어서 자리를 만든다.
 *
 * 반드시 지켜야 하는 것 셋:
 *   - 기본값은 꺼짐. 미리 체크해 두면 명시적 동의로 인정되지 않는다.
 *   - 약관 동의로 갈음할 수 없다. 별도 항목이어야 한다.
 *   - 동의하지 않아도 서비스는 그대로 쓸 수 있어야 한다(개인정보 보호법 제16조제3항).
 *
 * 동의한 날짜를 남기는 것은 제50조제8항이 2년마다 수신 여부를 다시 확인하도록
 * 하기 때문이다. 언제 받았는지 모르면 그 주기를 지킬 수 없다.
 */
model MarketingConsent {
  userId    String   @id
  agreed    Boolean  @default(false)
  /// 마지막으로 의사를 표시한 시각. 철회하면 이 값도 갱신된다.
  changedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * 한 판이 어떻게 끝났는지에 대한 집계.
 *
 * 개인과 이어지지 않는다. 누가 했는지는 넣지 않고 그날의 합만 센다. 그래서 개인정보가
 * 아니고(제58조의2), 목적을 좁게 적을 필요도 보관 기간을 둘 이유도 없다.
 *
 * 방문 수와 플레이 수만으로는 "재미없어서 나갔다"를 못 본다. 시작은 했는데 끝을
 * 못 본 판이 얼마나 되는지, 평균 몇 문항에서 멈추는지가 문항을 손볼 근거가 된다.
 * 나라를 함께 두는 것은 어느 언어권에서 유독 중간에 나가는지를 보기 위해서다.
 */
model RoundStat {
  day     String // YYYY-MM-DD
  /// "balance" | "archq"
  game    String
  device  String // mobile | desktop
  lang    String
  /// IP 로 추정한 두 글자 국가 코드. 도시나 좌표는 받지 않는다.
  country String

  /// 시작한 판과 끝까지 간 판. 둘의 비가 완주율이다.
  started  Int @default(0)
  finished Int @default(0)
  /// 답한 문항 수의 합. started 로 나누면 평균 몇 문항에서 멈추는지가 나온다.
  answered Int @default(0)

  @@id([day, game, device, lang, country])
  @@index([day])
}

/**
 * 설계자 맞히기 기록.
 *
 * 모드마다 따로 겨룬다. 10문항과 30문항을 한 표에 섞으면 문항 수가 많은 쪽이
 * 무조건 유리해서 순위가 뜻을 잃고, 타임어택은 아예 단위가 다르다.
 *   q10 / q20 / q30   문항 수 모드. 많이 맞힌 사람이 위, 같으면 빨리 끝낸 사람이 위.
 *   t60 / t120        타임어택. 제한 시간 안에 많이 맞힌 사람이 위.
 *
 * 한 사람당 모드별로 한 줄만 둔다. 판마다 줄을 쌓으면 많이 한 사람이 순위표를
 * 도배하게 되고, 남기고 싶은 것은 그 사람의 최고 기록이다. 새 기록이 더 좋을 때만
 * 갱신한다.
 *
 * 로그인해야 남는다. 기록이 누구 것인지 알 수 없으면 순위표가 성립하지 않는다.
 */
model ArchqScore {
  userId String
  /// "q10" | "q20" | "q30" | "t60" | "t120"
  mode   String

  /// 맞힌 개수.
  score  Int
  /// 걸린 시간(초). 문항 모드에서 동점자를 가른다. 타임어택은 제한 시간이 곧 이 값이다.
  secs   Int
  /// 그때 쓰던 닉네임. 나중에 닉네임을 바꿔도 순위표가 흔들리지 않게 함께 둔다.
  name   String
  playedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, mode])
  /// 순위표는 모드별로 점수 높은 순, 같으면 빠른 순으로 뽑는다.
  @@index([mode, score, secs])
}
